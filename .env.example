# Local development points at a MongoDB on the default port.
# In production set these in the Vercel project's environment variables.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="hackclub_nust"

# Optional: the local API port (defaults to 8787)
# GAME_API_PORT=8787

# Shared key staff enter at /staff (HackPass redemption) and /applications
# (the applications inbox). Generate with:
#   node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
# HACKPASS_STAFF_KEY is still read as a fallback, for environments set up earlier.
STAFF_KEY="change-me"
